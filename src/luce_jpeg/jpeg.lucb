## 8-bit Huffman JPEG: sequential/progressive scans, restart markers and IDCT.
import memory
import math
from binary import Reader, Buffer
from raster import Raster
from raster_errors import corrupt, unsupported, invalid, limit

let zigzag: usize[64] = [0,1,8,16,9,2,3,10,17,24,32,25,18,11,4,5,12,19,26,33,40,48,41,34,27,20,13,6,7,14,21,28,35,42,49,56,57,50,43,36,29,22,15,23,30,37,44,51,58,59,52,45,38,31,39,46,53,60,61,54,47,55,62,63]

struct Bits:
    var reader: Reader
    var value: u32
    var count: u32

    mutating func read(n: u32) -> u32!:
        var out: u32 = 0
        for i in 0..<n:
            if self.count == 0:
                self.value = (u32)(try self.reader.byte())
                if self.value == 255 and try self.reader.byte() != 0:
                    error(corrupt, "unexpected JPEG marker inside entropy data")
                self.count = 8
            self.count -= 1
            out = (out << 1) | ((self.value >> self.count) & 1)
        return out

struct Huffman:
    var counts: u32[17]
    var symbols: u8[256]
    var present: bool

    func decode(bits: Bits*) -> u32!:
        if not self.present:
            error(corrupt, "JPEG Huffman table missing")
        var code: u32 = 0
        var first: u32 = 0
        var index: u32 = 0
        for n in 1..<17:
            code = (code << 1) | (try bits.read(1))
            if code >= first and code - first < self.counts[n]:
                return (u32)self.symbols[(usize)(index + code - first)]
            index += self.counts[n]
            first = (first + self.counts[n]) << 1
        error(corrupt, "invalid JPEG Huffman code")

struct Component:
    var id: u8
    var horizontal: usize
    var vertical: usize
    var quant: usize
    var dc: usize
    var ac: usize
    var predictor: i32
    var bx: usize
    var by: usize
    var actual_bx: usize
    var actual_by: usize
    var coefficients: i32[]
    var pixels: f64[]
    var progression: i32[64]

struct Decoder:
    var image: Raster*
    var components: Component[4]
    var count: usize
    var tables: Huffman[8]
    var quant: u32[256]
    var quant_present: bool[4]
    var max_h: usize
    var max_v: usize
    var mcux: usize
    var mcuy: usize
    var restart: usize
    var progressive: bool
    var eob: usize
    var adobe: i32 = -1

    mutating func close():
        for i in 0..<self.count:
            if self.components[i].coefficients.length > 0:
                free(self.components[i].coefficients) in memory.heap
            if self.components[i].pixels.length > 0:
                free(self.components[i].pixels) in memory.heap

func marker(reader: Reader*) -> u8!:
    if try reader.byte() != 255:
        error(corrupt, "JPEG marker prefix missing")
    var value = try reader.byte()
    while value == 255:
        value = try reader.byte()
    if value == 0:
        error(corrupt, "JPEG stuffed byte outside scan")
    return value

func segment(reader: Reader*) -> Reader!:
    let size = (usize)(try reader.uint(2))
    if size < 2:
        error(corrupt, "JPEG marker length below two")
    return Reader(data = try reader.take(size - 2), little = false)

pub func probe(image: Raster*) -> !:
    var r = Reader(data = image.encoded, little = false)
    if try r.uint(2) != 65496:
        error(corrupt, "invalid JPEG signature")
    while true:
        let code = try marker(&r)
        if code == 217 or code == 218:
            error(corrupt, "JPEG has no frame header")
        var s = try segment(&r)
        if code == 192 or code == 193 or code == 194:
            if try s.byte() != 8:
                error(unsupported, "JPEG sample precision must be 8 bits")
            image.height = (usize)(try s.uint(2))
            image.width = (usize)(try s.uint(2))
            let nc = (usize)(try s.byte())
            if nc != 1 and nc != 3 and nc != 4:
                error(unsupported, "JPEG requires grayscale, RGB/YCbCr or CMYK/YCCK")
            image.photo = (u64)nc
            try image.standard(3 if nc == 4 else nc, .uint8)
            discard(try image.validate())
            image.file_format = "JPEG"
            return
        if code >= 195 and code <= 207 and code != 196 and code != 200 and code != 204:
            error(unsupported, "lossless or arithmetic JPEG is not supported")

func extend(bits: Bits*, count: u32) -> i32!:
    if count == 0:
        return 0
    if count > 16:
        error(corrupt, "JPEG coefficient size exceeds 16 bits")
    let v = try bits.read(count)
    return (i32)v if v >= ((u32)1 << (count - 1)) else (i32)v + 1 - ((i32)1 << count)

func refine(value: i32*, bits: Bits*, shift: u32) -> !:
    let bit = try bits.read(1)
    let step = (i32)1 << shift
    if bit != 0 and ((*value if *value >= 0 else -*value) & step) == 0:
        *value += step if *value >= 0 else -step

func block(d: Decoder*, component: Component*, coefficients: i32[], bits: Bits*, ss: usize, se: usize, ah: u32, al: u32) -> !:
    if ss == 0:
        if ah == 0:
            let size = try d.tables[component.dc].decode(bits)
            if size > 11:
                error(corrupt, "JPEG DC difference too large")
            let diff = try extend(bits, size)
            component.predictor += diff
            if component.predictor < -32768 or component.predictor > 32767:
                error(corrupt, "JPEG DC predictor out of range")
            coefficients[0] = component.predictor << al
        else:
            coefficients[0] |= (i32)(try bits.read(1)) << al
        if se == 0:
            return
    var k: usize = 1 if ss == 0 else ss
    if ah == 0:
        if d.eob > 0:
            d.eob -= 1
            return
        while k <= se:
            let symbol = try d.tables[component.ac + 4].decode(bits)
            let run = (usize)(symbol >> 4)
            let size = symbol & 15
            if size == 0:
                if run == 15:
                    k += 16
                    if k > se + 1:
                        error(corrupt, "JPEG zero run exceeds spectral band")
                    continue
                if not d.progressive and run != 0:
                    error(corrupt, "invalid sequential JPEG EOB")
                d.eob = ((usize)1 << run) + (usize)(try bits.read((u32)run)) - 1
                break
            if size > 10:
                error(corrupt, "JPEG AC coefficient too large")
            k += run
            if k > se:
                error(corrupt, "JPEG AC run exceeds spectral band")
            coefficients[zigzag[k]] = (try extend(bits, size)) << al
            k += 1
    else:
        if d.eob == 0:
            while k <= se:
                let symbol = try d.tables[component.ac + 4].decode(bits)
                var run = (usize)(symbol >> 4)
                let size = symbol & 15
                var new_value: i32 = 0
                if size == 0:
                    if run != 15:
                        d.eob = ((usize)1 << run) + (usize)(try bits.read((u32)run))
                        break
                    run = 16
                elif size == 1:
                    new_value = ((i32)1 << al) if try bits.read(1) != 0 else -((i32)1 << al)
                else:
                    error(corrupt, "invalid progressive JPEG refinement")
                while k <= se:
                    let slot = &coefficients[zigzag[k]]
                    if *slot != 0:
                        try refine(slot, bits, al)
                    elif run == 0:
                        break
                    else:
                        run -= 1
                    k += 1
                    if new_value == 0 and run == 0:
                        break
                if new_value != 0:
                    if k > se:
                        error(corrupt, "JPEG refinement exceeds spectral band")
                    coefficients[zigzag[k]] = new_value
                    k += 1
                elif run != 0:
                    error(corrupt, "JPEG refinement zero run exceeds band")
        if d.eob > 0:
            while k <= se:
                if coefficients[zigzag[k]] != 0:
                    try refine(&coefficients[zigzag[k]], bits, al)
                k += 1
            d.eob -= 1

func scan(d: Decoder*, header: Reader*, reader: Reader*) -> !:
    let ns = (usize)(try header.byte())
    if ns < 1 or ns > d.count:
        error(corrupt, "invalid JPEG scan component count")
    var selected: usize[4]
    for i in 0..<ns:
        let id = try header.byte()
        let tables = try header.byte()
        if (tables >> 4) > 3 or (tables & 15) > 3:
            error(corrupt, "invalid JPEG table selector")
        var found = false
        for c in 0..<d.count:
            if d.components[c].id == id:
                selected[i] = c
                found = true
        if not found:
            error(corrupt, "JPEG scan references unknown component")
        for j in 0..<i:
            if selected[j] == selected[i]:
                error(corrupt, "duplicate JPEG scan component")
        d.components[selected[i]].dc = (usize)(tables >> 4)
        d.components[selected[i]].ac = (usize)(tables & 15)
        d.components[selected[i]].predictor = 0
    let ss = (usize)(try header.byte())
    let se = (usize)(try header.byte())
    let approx = try header.byte()
    let ah = (u32)(approx >> 4)
    let al = (u32)(approx & 15)
    if ss > se or se > 63 or al > 13 or ah > 13 or (not d.progressive and (ss != 0 or se != 63 or ah != 0 or al != 0)) or (d.progressive and ((ss == 0 and se != 0) or (ss > 0 and ns != 1))) or (ah != 0 and ah != al + 1):
        error(corrupt, "invalid JPEG scan parameters")
    for i in 0..<ns:
        let component = &d.components[selected[i]]
        for k in ss..<se + 1:
            if (ah == 0 and component.progression[k] != -1) or (ah != 0 and component.progression[k] != (i32)ah):
                error(corrupt, "invalid JPEG progressive scan order")
            component.progression[k] = (i32)al
    var bits = Bits(reader = *reader)
    d.eob = 0
    let across = d.components[selected[0]].actual_bx if ns == 1 else d.mcux
    let down = d.components[selected[0]].actual_by if ns == 1 else d.mcuy
    var restart_marker: u8 = 208
    for mcu in 0..<across * down:
        if mcu > 0 and d.restart > 0 and mcu % d.restart == 0:
            bits.count = 0
            if try marker(&bits.reader) != restart_marker or d.eob != 0:
                error(corrupt, "JPEG restart marker mismatch")
            restart_marker = 208 if restart_marker == 215 else restart_marker + 1
            for i in 0..<ns:
                d.components[selected[i]].predictor = 0
        for i in 0..<ns:
            let component = &d.components[selected[i]]
            let horizontal: usize = 1 if ns == 1 else component.horizontal
            let vertical: usize = 1 if ns == 1 else component.vertical
            for y in 0..<vertical:
                for x in 0..<horizontal:
                    let bx = (mcu % across) * horizontal + x
                    let by = (mcu // across) * vertical + y
                    let start = (by * component.bx + bx) * 64
                    try block(d, component, component.coefficients[start..<start + 64], &bits, ss, se, ah, al)
    if d.eob != 0:
        error(corrupt, "JPEG EOB run exceeds scan")
    *reader = bits.reader

func frame(d: Decoder*, h: Reader*, code: u8) -> !:
    if d.count != 0:
        error(corrupt, "multiple JPEG frame headers")
    if try h.byte() != 8:
        error(unsupported, "JPEG requires 8-bit precision")
    if try h.uint(2) != (u64)d.image.height or try h.uint(2) != (u64)d.image.width:
        error(corrupt, "JPEG frame dimensions changed")
    d.count = (usize)(try h.byte())
    if (u64)d.count != d.image.photo:
        error(corrupt, "JPEG frame component count mismatch")
    d.progressive = code == 194
    var blocks: usize = 0
    for i in 0..<d.count:
        let c = &d.components[i]
        c.id = try h.byte()
        let sampling = try h.byte()
        c.horizontal = (usize)(sampling >> 4)
        c.vertical = (usize)(sampling & 15)
        c.quant = (usize)(try h.byte())
        if c.horizontal == 0 or c.horizontal > 4 or c.vertical == 0 or c.vertical > 4 or c.quant > 3:
            error(corrupt, "invalid JPEG sampling factors")
        for j in 0..<i:
            if d.components[j].id == c.id:
                error(corrupt, "duplicate JPEG component ID")
        d.max_h = c.horizontal if c.horizontal > d.max_h else d.max_h
        d.max_v = c.vertical if c.vertical > d.max_v else d.max_v
        blocks += c.horizontal * c.vertical
    if blocks > 10:
        error(corrupt, "JPEG MCU has too many blocks")
    d.mcux = (d.image.width + d.max_h * 8 - 1) // (d.max_h * 8)
    d.mcuy = (d.image.height + d.max_v * 8 - 1) // (d.max_v * 8)
    var allocated: usize = 0
    for i in 0..<d.count:
        let c = &d.components[i]
        c.bx = d.mcux * c.horizontal
        c.by = d.mcuy * c.vertical
        c.actual_bx = (d.image.width * c.horizontal + d.max_h * 8 - 1) // (d.max_h * 8)
        c.actual_by = (d.image.height * c.vertical + d.max_v * 8 - 1) // (d.max_v * 8)
        let count = c.bx * c.by * 64
        allocated += count * 12
        if allocated > d.image.max_bytes:
            error(limit, "JPEG coefficient and sample buffers exceed byte limit")
        c.coefficients = try new i32[count] in memory.heap
        c.pixels = try new f64[count] in memory.heap
        for k in 0..<64:
            c.progression[k] = -1

func idct(d: Decoder*) -> !:
    var cosine: f64[64]
    for x in 0..<(usize)8:
        for k in 0..<(usize)8:
            cosine[x * 8 + k] = math.cos((f64)((2 * x + 1) * k) * 3.141592653589793 / 16.0) * (0.7071067811865476 if k == 0 else 1.0)
    for cindex in 0..<d.count:
        let c = &d.components[cindex]
        if not d.quant_present[c.quant] or c.progression[0] == -1:
            error(corrupt, "JPEG component lacks quantization or DC scan")
        for by in 0..<c.by:
            for bx in 0..<c.bx:
                var temp: f64[64]
                let block_start = (by * c.bx + bx) * 64
                for y in 0..<(usize)8:
                    for x in 0..<(usize)8:
                        var sum: f64 = 0.0
                        for k in 0..<(usize)8:
                            sum += (f64)c.coefficients[block_start + y * 8 + k] * (f64)d.quant[c.quant * 64 + y * 8 + k] * cosine[x * 8 + k]
                        temp[y * 8 + x] = sum * 0.5
                for y in 0..<(usize)8:
                    for x in 0..<(usize)8:
                        var sum: f64 = 0.0
                        for k in 0..<(usize)8:
                            sum += temp[k * 8 + x] * cosine[y * 8 + k]
                        c.pixels[(by * 8 + y) * c.bx * 8 + bx * 8 + x] = math.clamp(math.floor(sum * 0.5 + 128.5), 0.0, 255.0)

func component_sample(d: const Decoder*, c: const Component*, x: usize, y: usize) -> f64:
    let sx = math.clamp(((f64)x + 0.5) * (f64)c.horizontal / (f64)d.max_h - 0.5, 0.0, (f64)((d.image.width * c.horizontal + d.max_h - 1) // d.max_h - 1))
    let sy = math.clamp(((f64)y + 0.5) * (f64)c.vertical / (f64)d.max_v - 0.5, 0.0, (f64)((d.image.height * c.vertical + d.max_v - 1) // d.max_v - 1))
    let x0 = (usize)math.floor(sx)
    let y0 = (usize)math.floor(sy)
    let x1 = x0 + 1 if x0 + 1 < c.bx * 8 else x0
    let y1 = y0 + 1 if y0 + 1 < c.by * 8 else y0
    let fx = sx - (f64)x0
    let fy = sy - (f64)y0
    let a = c.pixels[y0 * c.bx * 8 + x0] * (1.0 - fx) + c.pixels[y0 * c.bx * 8 + x1] * fx
    let b = c.pixels[y1 * c.bx * 8 + x0] * (1.0 - fx) + c.pixels[y1 * c.bx * 8 + x1] * fx
    return a * (1.0 - fy) + b * fy

pub func decode(image: Raster*) -> !:
    var d = Decoder(image = image)
    defer d.close()
    var reader = Reader(data = image.encoded, position = 2, little = false)
    var ended = false
    while reader.position < reader.data.length:
        let code = try marker(&reader)
        if code == 217:
            ended = true
            break
        var s = try segment(&reader)
        if code == 192 or code == 193 or code == 194:
            try frame(&d, &s, code)
        elif code == 219:
            while s.position < s.data.length:
                let info = try s.byte()
                let index = (usize)(info & 15)
                let precision = info >> 4
                if index > 3 or precision > 1:
                    error(corrupt, "invalid JPEG quantization table")
                for i in 0..<(usize)64:
                    let value = try s.uint(2 if precision == 1 else 1)
                    if value == 0:
                        error(corrupt, "zero JPEG quantization value")
                    d.quant[index * 64 + zigzag[i]] = (u32)value
                d.quant_present[index] = true
        elif code == 196:
            while s.position < s.data.length:
                let info = try s.byte()
                if (info >> 4) > 1 or (info & 15) > 3:
                    error(corrupt, "invalid JPEG Huffman table selector")
                let table = &d.tables[(usize)(info & 15) + (4 if (info >> 4) == 1 else 0)]
                *table = Huffman()
                var count: usize = 0
                var left: i32 = 1
                for n in 1..<(usize)17:
                    table.counts[n] = (u32)(try s.byte())
                    count += (usize)table.counts[n]
                    left = left * 2 - (i32)table.counts[n]
                    if left < 0:
                        error(corrupt, "oversubscribed JPEG Huffman table")
                if count > 256 or count == 0:
                    error(corrupt, "invalid JPEG Huffman symbol count")
                let values = try s.take(count)
                for i in 0..<count:
                    table.symbols[i] = values[i]
                table.present = true
        elif code == 221:
            d.restart = (usize)(try s.uint(2))
        elif code == 218:
            if d.count == 0:
                error(corrupt, "JPEG scan before frame")
            try scan(&d, &s, &reader)
        elif code == 238 and s.data.length >= 12 and (str)s.data[..<5] == "Adobe":
            d.adobe = (i32)s.data[11]
        elif (code >= 195 and code <= 207) or code == 220:
            error(unsupported, "unsupported JPEG coding process")
    if not ended:
        error(corrupt, "JPEG end marker missing")
    try idct(&d)
    let direct = d.adobe == 0 or (d.count == 3 and d.components[0].id == 'R' and d.components[1].id == 'G' and d.components[2].id == 'B')
    for y in 0..<image.height:
        for x in 0..<image.width:
            let a = component_sample(&d, &d.components[0], x, y)
            let target = (y * image.width + x) * image.channels.length
            if d.count == 1:
                image.pixels[target] = math.floor(a + 0.5)
            else:
                let b = component_sample(&d, &d.components[1], x, y)
                let c = component_sample(&d, &d.components[2], x, y)
                var red = a if direct else a + 1.402 * (c - 128.0)
                var green = b if direct else a - 0.344136 * (b - 128.0) - 0.714136 * (c - 128.0)
                var blue = c if direct else a + 1.772 * (b - 128.0)
                if d.count == 4:
                    let black = component_sample(&d, &d.components[3], x, y)
                    if d.adobe == 2:
                        red = (255.0 - math.clamp(red, 0.0, 255.0)) * black / 255.0
                        green = (255.0 - math.clamp(green, 0.0, 255.0)) * black / 255.0
                        blue = (255.0 - math.clamp(blue, 0.0, 255.0)) * black / 255.0
                    elif d.adobe == 0:
                        red = a * black / 255.0
                        green = b * black / 255.0
                        blue = c * black / 255.0
                    else:
                        red = (255.0 - a) * (255.0 - black) / 255.0
                        green = (255.0 - b) * (255.0 - black) / 255.0
                        blue = (255.0 - c) * (255.0 - black) / 255.0
                image.pixels[target] = math.floor(math.clamp(red, 0.0, 255.0) + 0.5)
                image.pixels[target + 1] = math.floor(math.clamp(green, 0.0, 255.0) + 0.5)
                image.pixels[target + 2] = math.floor(math.clamp(blue, 0.0, 255.0) + 0.5)

struct BitWriter:
    var out: Buffer*
    var value: u32
    var count: u32

    mutating func put(value: u32, count: u32) -> !:
        var n = count
        while n > 0:
            n -= 1
            self.value = (self.value << 1) | ((value >> n) & 1)
            self.count += 1
            if self.count == 8:
                try self.out.byte((u8)self.value)
                if (u8)self.value == 255:
                    try self.out.byte(0)
                self.count = 0
                self.value = 0

    mutating func coefficient(value: i32, dc: bool, run: u32 = 0) -> !:
        var magnitude = (u32)(value if value >= 0 else -value)
        var count: u32 = 0
        while magnitude != 0:
            magnitude >>= 1
            count += 1
        if dc:
            if count > 11:
                error(invalid, "JPEG DC coefficient out of range")
            try self.put(count, 4)
        else:
            if count > 10 or count == 0:
                error(invalid, "JPEG AC coefficient out of range")
            try self.put(2 + run * 10 + count - 1, 8)
        if count > 0:
            try self.put((u32)(value if value >= 0 else value - 1) & (((u32)1 << count) - 1), count)

func emit_segment(output: Buffer*, code: u8, data: const u8[]) -> !:
    try output.byte(255)
    try output.byte(code)
    try output.uint((u64)data.length + 2, 2, false)
    try output.put(data)

let quantization: u32[64] = [16,11,10,16,24,40,51,61,12,12,14,19,26,58,60,55,14,13,16,24,40,57,69,56,14,17,22,29,51,87,80,62,18,22,37,56,68,109,103,77,24,35,55,64,81,104,113,92,49,64,78,87,103,121,120,101,72,92,95,98,112,100,103,99]

pub func encode(image: const Raster*, output: Buffer*, quality: i64 = 90) -> !:
    let nc = image.channels.length
    if nc != 1 and nc != 3:
        error(unsupported, "JPEG requires grayscale or RGB; convert alpha explicitly")
    if image.width > 65535 or image.height > 65535 or quality < 1 or quality > 100:
        error(invalid, "JPEG dimensions or quality out of range")
    for c in image.channels:
        if c.kind != .uint8:
            error(unsupported, "JPEG requires uint8 samples")
    for value in image.pixels:
        if not math.is_finite(value) or value < 0.0 or value > 255.0:
            error(invalid, "JPEG sample out of range")
    var quant: u32[64]
    let scale = (u32)(5000 // quality if quality < 50 else 200 - quality * 2)
    for i in 0..<64:
        let q = (quantization[i] * scale + 50) // 100
        quant[i] = 1 if q < 1 else 255 if q > 255 else q
    try output.put(b"\xff\xd8")
    try emit_segment(output, 224, b"JFIF\0\x01\x01\0\0\x01\0\x01\0\0")
    var data = Buffer()
    defer data.close()
    try data.byte(0)
    for i in 0..<64:
        try data.byte((u8)quant[zigzag[i]])
    try emit_segment(output, 219, data.view())
    data.used = 0
    try data.byte(8)
    try data.uint((u64)image.height, 2, false)
    try data.uint((u64)image.width, 2, false)
    try data.byte((u8)nc)
    for c in 0..<nc:
        try data.byte((u8)c + 1)
        try data.byte(17)
        try data.byte(0)
    try emit_segment(output, 192, data.view())
    data.used = 0
    try data.byte(0)
    for i in 1..<17:
        try data.byte(12 if i == 4 else 0)
    for i in 0..<12:
        try data.byte((u8)i)
    try data.byte(16)
    for i in 1..<17:
        try data.byte(162 if i == 8 else 0)
    try data.byte(0)
    try data.byte(240)
    for run in 0..<16:
        for size in 1..<11:
            try data.byte((u8)(run * 16 + size))
    try emit_segment(output, 196, data.view())
    data.used = 0
    try data.byte((u8)nc)
    for c in 0..<nc:
        try data.byte((u8)c + 1)
        try data.byte(0)
    try data.put(b"\0\x3f\0")
    try emit_segment(output, 218, data.view())
    var bits = BitWriter(out = output)
    var predictors: i32[3]
    var cosine: f64[64]
    for k in 0..<(usize)8:
        for x in 0..<(usize)8:
            cosine[k * 8 + x] = math.cos((f64)((2 * x + 1) * k) * 3.141592653589793 / 16.0) * (0.7071067811865476 if k == 0 else 1.0)
    let across = (image.width + 7) // 8
    let down = (image.height + 7) // 8
    for by in 0..<down:
        for bx in 0..<across:
            for c in 0..<nc:
                var samples: f64[64]
                var temp: f64[64]
                var coefficients: i32[64]
                for y in 0..<(usize)8:
                    for x in 0..<(usize)8:
                        let sx = bx * 8 + x if bx * 8 + x < image.width else image.width - 1
                        let sy = by * 8 + y if by * 8 + y < image.height else image.height - 1
                        let index = (sy * image.width + sx) * nc
                        let r = image.pixels[index]
                        var value = r
                        if nc == 3:
                            let g = image.pixels[index + 1]
                            let b = image.pixels[index + 2]
                            value = 0.299 * r + 0.587 * g + 0.114 * b if c == 0 else -0.168736 * r - 0.331264 * g + 0.5 * b + 128.0 if c == 1 else 0.5 * r - 0.418688 * g - 0.081312 * b + 128.0
                        samples[y * 8 + x] = value - 128.0
                for y in 0..<(usize)8:
                    for k in 0..<(usize)8:
                        var sum: f64 = 0.0
                        for x in 0..<(usize)8:
                            sum += samples[y * 8 + x] * cosine[k * 8 + x]
                        temp[y * 8 + k] = sum * 0.5
                for k in 0..<(usize)8:
                    for x in 0..<(usize)8:
                        var sum: f64 = 0.0
                        for y in 0..<(usize)8:
                            sum += temp[y * 8 + x] * cosine[k * 8 + y]
                        let value = sum * 0.5 / (f64)quant[k * 8 + x]
                        coefficients[k * 8 + x] = (i32)(math.floor(value + 0.5) if value >= 0.0 else -math.floor(-value + 0.5))
                try bits.coefficient(coefficients[0] - predictors[c], true)
                predictors[c] = coefficients[0]
                var run: u32 = 0
                for i in 1..<(usize)64:
                    let value = coefficients[zigzag[i]]
                    if value == 0:
                        run += 1
                    else:
                        while run >= 16:
                            try bits.put(1, 8)
                            run -= 16
                        try bits.coefficient(value, false, run)
                        run = 0
                if run > 0:
                    try bits.put(0, 8)
    if bits.count > 0:
        try bits.put(((u32)1 << (8 - bits.count)) - 1, 8 - bits.count)
    try output.put(b"\xff\xd9")
